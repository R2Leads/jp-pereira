# Copie este arquivo para .env e troque os valores antes de subir com Docker.
# Nada aqui vai para o Git.

# Senha do PostgreSQL criado pelo docker-compose.selfhost.yml.
POSTGRES_PASSWORD=defina-uma-senha-forte

# Chave da sessão administrativa: 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Acesso ao painel de pontos de venda (/admin/pontos-de-venda).
ADMIN_USERNAME=admin
# Gere com: npm run admin:hash
ADMIN_PASSWORD_HASH=

# Opcional: busca de endereços no localizador (sem chave, o localizador
# continua listando por cidade/CEP, mas sem autocomplete de endereço).
GEOAPIFY_API_KEY=

# URL pública da instalação (com https quando houver domínio/SSL).
APP_ORIGIN=http://localhost:3000

# Porta exposta no servidor.
APP_PORT=3000
