# Variáveis de produção — JP Pereira
# Preencha no painel de variáveis da hospedagem; não envie este arquivo preenchido ao Git.

# Banco PostgreSQL de produção (Supabase).
DATABASE_URL=

# Sessão administrativa: no mínimo 32 caracteres aleatórios.
SESSION_SECRET=

# Acesso ao painel de pontos de venda.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Chave Geoapify criada para o IP de saída do servidor de produção.
GEOAPIFY_API_KEY=

# Produção sempre false. O modo demo só existe no ambiente local.
DEMO_LOCAL_ONLY=false

# URL pública da aplicação (sem barra final).
APP_ORIGIN=https://deploy.jppereira.com.br

# Envio de e-mail do formulario (Microsoft 365: smtp.office365.com porta 587).
# Opcional: o formulario ja entrega a mensagem pelo WhatsApp; o e-mail so e
# enviado quando estas variaveis estiverem preenchidas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=fv@jppereira.com.br
MAIL_TO_CONTATO=fv@jppereira.com.br
MAIL_TO_REVENDA=fv@jppereira.com.br
